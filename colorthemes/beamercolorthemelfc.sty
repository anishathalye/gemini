% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% Colors from https://www.lakeforest.edu/offices-and-departments/communications-and-marketing/the-lake-forest-college-brand/college-style-guide
\definecolor{LFC-Red}{RGB}{194, 20, 48}
\definecolor{LFC-Gold}{RGB}{184, 166, 110}
\definecolor{LFC-Red-Light}{RGB}{243, 190, 196}
\colorlet{LFC-Red-Light-BG}{LFC-Red!15}
\colorlet{LFC-Gold-Light}{LFC-Gold!20}

% Basic Colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=LFC-Red}

% Headline
\setbeamercolor{headline}{fg=white,bg=LFC-Red}
\setbeamercolor{headline rule}{bg=LFC-Gold}

% Block
\setbeamercolor{block title}{fg=LFC-Red,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=LFC-Red,bg=LFC-Red-Light-BG}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=LFC-Red-Light-BG}

% Example Block
\setbeamercolor{block example title}{fg=LFC-Red,bg=LFC-Gold-Light}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=LFC-Gold-Light}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=LFC-Red}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}