% Gemini theme
% https://github.com/anishathalye/gemini

% An unofficial color theme using the University of Rochester palette.

% ====================
% Definitions
% ====================

% Colors from https://brand.rochester.edu/visual-identity/color-system/
\definecolor{urochesternavy}{RGB}{0, 30, 95}     % URochester Navy
\definecolor{everbutter}{RGB}{255, 243, 177}     % Ever Butter
\definecolor{meridiansilver}{RGB}{232, 232, 232} % Meridian Silver
\definecolor{wondroussky}{RGB}{183, 211, 255}    % Wondrous Sky

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=urochesternavy}

% Headline
\setbeamercolor{headline}{fg=white,bg=urochesternavy}

% Block
\setbeamercolor{block title}{fg=urochesternavy,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=urochesternavy,bg=everbutter}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=everbutter}

% Example Block
\setbeamercolor{block example title}{fg=urochesternavy,bg=wondroussky}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=wondroussky}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=urochesternavy}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
