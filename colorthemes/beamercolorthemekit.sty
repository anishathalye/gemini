% Gemini theme
% https://github.com/anishathalye/gemini
%
% KIT (Karlsruhe Institute of Technology) color theme

% ====================
% Definitions
% ====================

% KIT print colors from https://kit-cd.km.kit.edu/341.php
\definecolor{kitgreen}{cmyk}{1.0, 0.0, 0.6, 0.0}
\definecolor{kitblue}{cmyk}{0.8, 0.5, 0.0, 0.0}
\definecolor{kitdarkgray}{cmyk}{0.0, 0.0, 0.0, 0.7}

% Supporting colors for backgrounds
\definecolor{kitlightgreen}{cmyk}{0.15, 0.0, 0.1, 0.0}
\definecolor{lightgray}{RGB}{240, 240, 240}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=kitdarkgray}

% Headline
\setbeamercolor{headline}{fg=black,bg=lightgray}

% Block
\setbeamercolor{block title}{fg=kitgreen,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block title alerted}{fg=kitgreen,bg=kitlightgreen}
\setbeamercolor{block separator alerted}{bg=black}
\setbeamercolor{block body alerted}{fg=black,bg=kitlightgreen}

% Example Block
\setbeamercolor{block title example}{fg=kitgreen,bg=lightgray}
\setbeamercolor{block separator example}{bg=black}
\setbeamercolor{block body example}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=kitdarkgray}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
